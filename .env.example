# Environment configuration for Thota Mitra
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Open-Meteo endpoint (no API key required)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
ENABLE_LIVE_WEATHER=1

# Opt-in only. Configure both values to use the live Agmarknet adapter.
ENABLE_LIVE_AGMARKNET=1
AGMARKNET_RESOURCE_ID=
AGMARKNET_API_KEY=

# Cache configuration
WEATHER_CACHE_TTL_SECONDS=1800

# Default Plantation Location (Thirthahalli, Malnad, Karnataka - Arecanut heartland)
DEFAULT_LATITUDE=13.6934
DEFAULT_LONGITUDE=75.2427
DEFAULT_VILLAGE=Thirthahalli

# Optional LLM integration (for Phase 3)
OPENAI_API_KEY=
